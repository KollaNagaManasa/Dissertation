# RAGIAC_MODE=local uses the dependency-light offline embedder + in-memory vector store.
# RAGIAC_MODE=gcp uses Vertex AI embeddings/generation + Vertex AI Vector Search.
RAGIAC_MODE=local

GOOGLE_CLOUD_PROJECT=
# asia-south1 (Mumbai) = nearest live GCP region to Hyderabad; used for storage/embeddings/
# vector search. See README "Region choice" for why generation uses a separate setting below.
GOOGLE_CLOUD_REGION=asia-south1
# "global" keeps Gemini generation on whichever endpoint has the latest model available.
# Pin this to GOOGLE_CLOUD_REGION instead only if the dissertation's data-residency requirement
# extends to inference, not just storage.
VERTEX_GENERATION_LOCATION=global
GCS_BUCKET=
GCS_KNOWLEDGE_BASE_PREFIX=knowledge_base/

VERTEX_EMBEDDING_MODEL=text-embedding-005
VERTEX_GENERATION_MODEL=gemini-2.0-flash
VERTEX_VECTOR_INDEX_ID=
VERTEX_VECTOR_ENDPOINT_ID=
VERTEX_VECTOR_DEPLOYED_INDEX_ID=

TERRAFORM_BINARY=terraform
CONFTEST_BINARY=conftest

KNOWLEDGE_BASE_DIR=data/knowledge_base
POLICY_DIR=data/policies

CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
